# This skill reads secrets from ~/.config/abm-1to1/secrets.env, not from a local .env.
# Copy these keys into that file. Never commit a real one.
#
# A .env placed beside the scripts still wins if one exists, which is the only way to
# point a single run at a different token.

# --- required to publish the account pages -------------------------------
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- required to mint the LinkedIn token (see sops/00, Step 0) ------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- required to size audiences and build the campaign -------------------
# Needs r_ads and rw_ads on an app with access to the ad account.
LINKEDIN_ACCESS_TOKEN=

# --- optional: UK company filings, part 3 --------------------------------
COMPANIES_HOUSE_API_KEY=

# --- optional and PAID. Nothing calls these without asking first ---------
# ark_api        AI Ark people search, 0.5 credits per result returned
# OPENAI_API_KEY image generation, only if you are not building cards in HTML
# KIE_AI_API_KEY b-roll generation, see knowledge-base/pages-films-and-broll.md
ark_api=
OPENAI_API_KEY=
KIE_AI_API_KEY=
